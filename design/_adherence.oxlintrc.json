{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/catalog/**",
              "components/core/**",
              "components/navigation/**",
              "doc-page.js",
              "ui_kits/admin/**",
              "ui_kits/shared/**",
              "ui_kits/storefront/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|IBM Plex Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, IBM Plex Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|strokeWidth|direction|style|key|ref|className|style|children)$/]",
        "message": "<ArrowMark> doesn't accept that prop. Declared props: width, height, strokeWidth, direction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowMark'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:right|left)$/]",
        "message": "<ArrowMark> direction must be one of 'right' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BackLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|onClick|key|ref|className|style|children)$/]",
        "message": "<BackLink> doesn't accept that prop. Declared props: children, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|href|onClick|fullWidth|disabled|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, href, onClick, fullWidth, disabled, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|inverse)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|index|image|href|onClick|aspect|key|ref|className|style|children)$/]",
        "message": "<CategoryTile> doesn't accept that prop. Declared props: name, index, image, href, onClick, aspect."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|selected|size|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, selected, size, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Chip> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|align|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: children, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<EmptyState> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|position|dim|background|tone|content|key|ref|className|style|children)$/]",
        "message": "<HeroSlide> doesn't accept that prop. Declared props: src, alt, position, dim, background, tone, content."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroSlide'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<HeroSlide> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|src|variant|alt|crop|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: size, src, variant, alt, crop, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:black|transparent)$/]",
        "message": "<Logo> variant must be one of 'black' | 'transparent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IphoneModel'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|href|key|ref|className|style|children)$/]",
        "message": "<IphoneModel> doesn't accept that prop. Declared props: name, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|parent|count|countSuffix|backHref|backLabel|onBack|showBack|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: title, parent, count, countSuffix, backHref, backLabel, onBack, showBack."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:price|stock|sku|lowStock|divider|key|ref|className|style|children)$/]",
        "message": "<PriceBlock> doesn't accept that prop. Declared props: price, stock, sku, lowStock, divider."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductGallery'] > JSXAttribute > JSXIdentifier[name!=/^(?:images|alt|aspect|key|ref|className|style|children)$/]",
        "message": "<ProductGallery> doesn't accept that prop. Declared props: images, alt, aspect."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|image|href|onClick|aspect|key|ref|className|style|children)$/]",
        "message": "<ProductTile> doesn't accept that prop. Declared props: name, price, image, href, onClick, aspect."
      },
      {
        "selector": "JSXOpeningElement[name.name='RangeHero'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|to|lead|animate|tone|key|ref|className|style|children)$/]",
        "message": "<RangeHero> doesn't accept that prop. Declared props: from, to, lead, animate, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='RangeHero'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|paper)$/]",
        "message": "<RangeHero> tone must be one of 'ink' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|title|size|tone|action|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: label, title, size, tone, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:section|headline)$/]",
        "message": "<SectionHeading> size must be one of 'section' | 'headline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|paper)$/]",
        "message": "<SectionHeading> tone must be one of 'ink' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|href|active|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: key, label, href, active."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
