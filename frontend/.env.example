# Copiá este archivo a .env.local y completá los valores.
# Supabase local (`npx supabase start`): corré `npx supabase status` para verlos.
# Producción: Project Settings > API en el dashboard de Supabase.

NEXT_PUBLIC_SUPABASE_URL=
# Solo la anon (public) key. NUNCA la secret/service_role key: NEXT_PUBLIC_ la expone al navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key de Supabase (la "service_role key" en local). Ignora RLS: la usan
# solo los Route Handlers de /app/api/* y los Server Components, del lado del
# servidor. Nunca con prefijo NEXT_PUBLIC_ ni en el navegador.
SUPABASE_SECRET_KEY=
