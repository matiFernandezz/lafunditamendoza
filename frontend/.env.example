# Copiá este archivo a .env.local y completá los valores.
# Supabase local (`supabase start`): corré `supabase status` para ver ambos.
# Producción: Project Settings > API en el dashboard de Supabase.

NEXT_PUBLIC_SUPABASE_URL=
# Solo la anon (public) key. NUNCA la service_role key: NEXT_PUBLIC_ la expone al navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend (Express) real. Usados solo del lado del servidor, por los Route
# Handlers de /app/api/* (nunca por el navegador) — por eso SIN prefijo
# NEXT_PUBLIC_. BACKEND_API_KEY es la misma API_KEY que el backend espera
# en el header x-api-key.
BACKEND_URL=
BACKEND_API_KEY=

# Numero de WhatsApp de la tienda (comprobantes de las ventas web), en
# formato internacional sin "+" ni espacios (ej. 5492611234567). Sin esto
# se usa un numero de prueba.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Datos para transferir en las ventas web (pantalla de la reserva). Sin alias
# y CBU se muestran datos de prueba, marcados como tales.
NEXT_PUBLIC_TRANSFER_ALIAS=
NEXT_PUBLIC_TRANSFER_CBU=
NEXT_PUBLIC_TRANSFER_HOLDER=
NEXT_PUBLIC_TRANSFER_BANK=
