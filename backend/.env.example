# En Railway la inyecta la plataforma automáticamente; no hace falta setearla ahí.
# Para desarrollo local, si no se define, el server usa 3001 por default.
PORT=3001

SUPABASE_URL=
SERVICE_ROLE_KEY=
API_KEY=

# URL del frontend (Vercel) permitida por CORS. Si no se define, CORS permite
# cualquier origen (útil en desarrollo).
FRONTEND_URL=
